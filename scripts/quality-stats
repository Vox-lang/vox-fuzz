#!/usr/bin/env bash
# Build (if stale) and run scripts/quality-stats.vox.
#
# The tool resolves docs/ledger/... and src/... from the repo root, so
# this cds there first -- and makes a relative --out absolute BEFORE the
# cd, so a path typed from somewhere else still means what it said. See
# the header comment of scripts/quality-stats.vox for what it does and
# which file owns which number.
set -u

root="$(cd "$(dirname "$0")/.." && pwd)"
VOX="${VOX:-$root/../vox/target/release/vox}"
# Same derivation as test.sh: pin the runtime to the compiler's own
# coreasm, or an installed /usr/share/vox/coreasm silently shadows it.
if [[ -z "${VOX_CORE_PATH:-}" ]]; then
    VOX_CORE_PATH="$(cd "$(dirname "$VOX")/../.." 2>/dev/null && pwd)/coreasm"
fi
export VOX_CORE_PATH
# The Vox side reads VOX_REPO for the sibling vox checkout it counts
# tests and defect-register entries in; default it from $VOX so a caller
# who already set VOX does not have to set both. This is not optional
# hygiene in a worktree: ../vox from worktrees/wt-foo is not the vox repo.
if [[ -z "${VOX_REPO:-}" ]]; then
    VOX_REPO="$(cd "$(dirname "$VOX")/../.." 2>/dev/null && pwd)"
    [[ -n "$VOX_REPO" ]] && export VOX_REPO
fi
# Where the installed json library's interface lives. vox-libs 0.2.0 puts
# json.lib in /usr/include/vox and libjson.so in /usr/lib64; the .lib
# names its own .so, so there is no -l and no -L to pass. The flag is
# needed at all because a bare `.lib` name does not reach /usr/include/vox
# on its own -- vox #99, open as of 2026-08-23.
VOX_LIB_PATH="${VOX_LIB_PATH:-/usr/include/vox}"

src="$root/scripts/quality-stats.vox"
bin="$root/build/quality-stats"
if [[ ! -x "$bin" || "$src" -nt "$bin" ]]; then
    if [[ ! -x "$VOX" ]]; then
        echo "quality-stats: vox binary not found at $VOX (set VOX=...)" >&2
        exit 2
    fi
    mkdir -p "$root/build"
    if ! "$VOX" "$src" --lib-path "$VOX_LIB_PATH" -o "$bin" > "$root/build/quality-stats.cerr" 2>&1; then
        echo "quality-stats: could not compile $src" >&2
        cat "$root/build/quality-stats.cerr" >&2
        exit 2
    fi
fi

# Absolutise the value of any path-taking flag while the caller's cwd is
# still current.
args=()
prev=""
for a in "$@"; do
    case "$prev" in
        --out|--vox-repo)
            # --out may name a file that does not exist yet, so it is the
            # DIRECTORY that has to be there; leave the value alone if it
            # is not, and let the Vox side report the failure by name.
            case "$a" in
                /*) ;;
                *) d="$(cd "$(dirname "$a")" 2>/dev/null && pwd)"
                   [[ -n "$d" ]] && a="$d/$(basename "$a")" ;;
            esac
            ;;
    esac
    args+=("$a")
    prev="$a"
done

cd "$root" || exit 2
exec "$bin" ${args[@]+"${args[@]}"}

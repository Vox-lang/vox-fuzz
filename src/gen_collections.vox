    'gen emit' of "{indent}a value called {'the present name'} is {'the present literal'}.\n".
    'gen emit' of "{indent}a boolean called {'the absent witness name'} is false.\n".
    'gen emit' of "{indent}If {'the absent name'} is nothing then, Set {'the absent witness name'} to true.\n".
    a text called 'the absent holds' is "{indent}If {'the absent witness name'} is false then, Print \"ASSERT VAL-25: expected is nothing to hold got {'what the absent one reported'}\", Exit 95.\n".
    'gen emit' of 'the absent holds'.
    a text called 'the absent denial' is "{indent}If {'the absent name'} is not nothing then, Print \"ASSERT VAL-25: expected is not nothing to be false got {'what the absent one reported'}\", Exit 95.\n".
    'gen emit' of 'the absent denial'.

    a text called 'the seen again' is 'gen environment companion' of "seen again".
    append "a boolean called {'the seen'} is false" to 'the lines'.
    append "If the environment variable \"{'the variable'}\" exists then, Set {'the seen'} to true. Print {'the seen'}" to 'the lines'.
    a number called 'the shape draw' is 'rng below' of 3.
    If 'the shape draw' is 0 then,
        append "a boolean called {'the seen again'} is false" to 'the lines',
        append "If the environment variable \"{'the variable'}\" exists then, Set {'the seen again'} to true. Print {'the seen again'}" to 'the lines',
        a text called 'the seen shown' is 'gen buffer slot of' of 'the seen',
        a text called 'the again shown' is 'gen buffer slot of' of 'the seen again',
        append "If {'the seen again'} is not {'the seen'} then, Print \"ASSERT ENV-10: expected {'the seen shown'} got {'the again shown'}\", Exit 95. Print {'the seen again'}" to 'the lines'.
    If 'the shape draw' is 1 then,
        a text called 'the present word' is 'gen environment spoken word',
        a text called 'the absent word' is 'gen environment spoken word',
        append "If the environment variable \"{'the variable'}\" exists then, Print \"{'the present word'}\". Otherwise, Print \"{'the absent word'}\". Print {'the seen'}" to 'the lines'.
    If 'the shape draw' is 2 then,
        a text called 'the greeting stem' is 'gen environment name',
        a text called 'the greeting' is 'gen buffer reference' of 'the greeting stem',
        a text called 'the default word' is 'gen environment spoken word',
        a number called 'the fallback id' is 'rng below' of 1000000,
        append "a text called {'the greeting'} is \"{'the default word'}\"" to 'the lines',
        append "If arguments's count is greater than 1 then, Set {'the greeting'} to arguments's first. But if the environment variable \"VOXFUZZ_UNSET_{'the fallback id'}\" exists then, Set {'the greeting'} to environment's \"VOXFUZZ_UNSET_{'the fallback id'}\". Print {'the greeting'}" to 'the lines'.
    If 'the name is unset' then,
        append "If {'the seen'} then, Print \"ASSERT ENV-10: expected 0 got 1\", Exit 95. Print {'the seen'}" to 'the lines'.
    If 'the name is unset' is false then,
        append "Print {'the seen'}" to 'the lines'.
    'gen join lines' of indent and nested and 'the lines'.

(A word a generated program may print - literal, harmless, varied.)

a list called gen_environment_spoken_words is ["present", "absent", "found", "missing", "set", "unset", "here", "elsewhere", "known", "unknown", "at home", "away", "yes", "no", "seen", "unseen"].

To 'gen environment spoken word'.

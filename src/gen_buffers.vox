    a text called 'the stale handler' is "On error Set {'the stale flag'} to true".
    a number called 'the payload length draw' is 'rng below' of 2000.
    a number called 'the payload length' is 'the payload length draw' add 4200.
    a text called 'the payload' is 'gen random digits' of 'the payload length'.
    a number called 'the verb draw' is 'rng below' of 2.
    a text called 'the verb line' is "".
    If 'the verb draw' is 0 then,
        Set 'the verb line' to "append \"{'the payload'}\" to {'the name'}".
    If 'the verb draw' is 1 then,
        Set 'the verb line' to "copy \"{'the payload'}\" to {'the name'}".
    a text called 'the flag declaration' is "a boolean called {'the overflow flag'} is false".
    a text called 'the handler line' is "On error Set {'the overflow flag'} to true".
    a text called 'the flag check' is 'gen assert false' of "BUF-36" and 'the overflow flag'.
    a text called 'the size check' is 'gen assert number is' of "BUF-36" and 'the size access' and 'the payload length'.
    a text called 'the capacity read' is "Print {'the capacity access'}".
    a list called 'the lines' is ['the declaration', 'the stale declaration', 'the stale handler', 'the flag declaration', 'the verb line', 'the handler line', 'the flag check', 'the size check', 'the capacity read'].
    'gen join lines' of indent and nested and 'the lines'.

    a text called 'the sink size' is 'gen buffer property' of 'the sink stem' and "size".
    a number called 'the line count draw' is 'rng below' of 8.
    a number called 'the line count' is 'the line count draw' add 1.
    a number called 'the newline draw' is 'rng below' of 2.
    a list called 'the payloads' is [].
    a text called 'the file content' is "".
    a number called 'the longest' is 0.
    a number called 'the built' is 0.
    While 'the built' is less than 'the line count',
        a number called 'the line length' is 'rng below' of 30,
        a text called 'the payload' is 'gen buffer filler' of 'the line length',
        append 'the payload' to 'the payloads',
        Set 'the file content' to "{'the file content'}{'the payload'}\\n",
        If 'the line length' is greater than 'the longest' then,
            Set 'the longest' to 'the line length'.
        Set 'the built' to 'the built' add 1.
    If 'the newline draw' is 1 then,
        Set 'the file content' to 'gen file content without final newline' of 'the payloads'.
    a list called 'the lines' is [].
    append "a text called {'the path name'} is \"{{{gen_scratch_flag}}}/{gen_file_ios}walk\"" to 'the lines'.
    append 'gen file open in any order' of "writing" and 'the handle' and 'the path name' to 'the lines'.
    append "Write \"{'the file content'}\" to {'the handle'}" to 'the lines'.
    append "Close {'the handle'}" to 'the lines'.
    append 'gen file open in any order' of "reading" and 'the handle' and 'the path name' to 'the lines'.
    a number called 'the slack' is 'rng below' of 8.
    a number called 'the capacity' is 'the longest' add 1 add 'the slack'.
    a text called 'the sink line' is "a buffer called {'the sink name'} is {'the capacity'} bytes in size".
    a number called 'the sink draw' is 'rng below' of 3.
    If 'the sink draw' is 0 then,
        Set 'the sink line' to 'gen dynamic buffer declaration' of 'the sink name'.
    append 'the sink line' to 'the lines'.
    a number called 'the line number' is 1.
    While 'the line number' is less than or equal to 'the line count',
        a text called 'the expected payload' is element 'the line number' of 'the payloads',
        a number called 'the expected length' is 'gen buffer filler length' of 'the expected payload',
        a text called 'the expected line' is "{'the expected payload'}\\n",
        If 'the line number' is 'the line count' and 'the newline draw' is 1 then,
            Set 'the expected line' to 'the expected payload'.

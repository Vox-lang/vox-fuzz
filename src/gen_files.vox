        append 'gen assert number is' of "FIL-50" and 'the sink size' and 'the expected length' to 'the lines',
        append "If {'the sink name'} is not \"{'the expected line'}\" then, Print \"ASSERT FIL-50: expected line {'the line number'} to read {'the expected payload'} got other bytes\", Exit 95. Print \"FIL-50 line {'the line number'} matches\"" to 'the lines',
        Set 'the line number' to 'the line number' add 1.
    append "Read line from {'the handle'} into {'the sink name'}" to 'the lines'.
    a text called 'the end check' is 'gen assert number is' of "FIL-54" and 'the sink size' and 0.
    append 'the end check' to 'the lines'.
    append "Close {'the handle'}" to 'the lines'.
    'gen join lines' of indent and nested and 'the lines'.


    append 'print float' to 'the lines'.
    append 'print text' to 'the lines'.
    append 'print buffer' to 'the lines'.
    append 'print boolean' to 'the lines'.
    append 'print list' to 'the lines'.
    append 'print map' to 'the lines'.

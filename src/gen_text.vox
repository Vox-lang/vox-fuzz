    a text called 'print all' is "Print \"all {'number slot'}|{'float slot'}|{'text slot'}|{'buffer slot'}|{'boolean slot'}|{'list slot'}|{'map slot'}|{'value slot'}{'the field tail'}\"".
    (Literal braces, the escape table's own rows, next to a live slot.)

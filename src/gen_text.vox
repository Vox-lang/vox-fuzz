    a text called 'buffer slot' is 'gen format slot' of "hw{n}" and "".
    a text called 'boolean slot' is 'gen format slot' of "hb{n}" and "".
    a text called 'list slot' is 'gen format slot' of "hl{n}" and "".
    a text called 'map slot' is 'gen format slot' of "hm{n}" and "".

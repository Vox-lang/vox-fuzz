    a text called 'print buffer' is "Print \"buffer {'buffer slot'}\"".
    a text called 'print boolean' is "Print \"boolean {'boolean slot'}\"".
    a text called 'print list' is "Print \"list {'list slot'}\"".
    a text called 'print map' is "Print \"map {'map slot'}\"".
    a text called 'print value' is "Print \"value {'value slot'}\"".
    a text called 'print field' is "Print \"field {'field slot'}\"".
    a text called 'the field tail' is "".

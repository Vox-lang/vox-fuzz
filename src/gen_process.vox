        'gen leaf print' of indent,
        Return a boolean, false.
    Set gen_file_ios to gen_file_ios add 1.
    a text called 'the path name' is 'gen process witness'.
    a number called 'the path number' is gen_buffer_names.
    a text called 'the path line' is "a text called {'the path name'} is \"{{{gen_scratch_flag}}}/procmount{'the path number'}\"".
    a text called 'the mkdir line' is "Create a directory called {'the path name'}".
    a number called 'the options draw' is 'rng below' of 2.
    a text called 'the mount line' is "Mount {'the path name'} at {'the path name'} with type \"tmpfs\"".
    If 'the options draw' is 1 then,
        Set 'the mount line' to "Mount {'the path name'} at {'the path name'} with type \"tmpfs\" with options \"size=1m\"".

   VOX_CORE_PATH=/home/josj/scr/english/vox/coreasm \
   /home/josj/scr/english/vox/target/release/vox \
   docs/ledger/probes/process-control/PRC-33.vox -o p && ./p
 expected output:
   the parent printed this
   the replacement program printed this
)
print "the parent printed this".
Execute "/bin/sh" with arguments ["-c", "echo the replacement program printed this"].
On error print "the exec failed".
print "this line is unreachable".

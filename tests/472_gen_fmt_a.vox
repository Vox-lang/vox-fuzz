'gen buffer names reset'.
clear gen_out.
'gen leaf format precision verified' of "" and false.
Print 'gen text'.

Print "--- FMT-19, 20: expressions in slots ---".
'rng seed' of 91.
'gen buffer names reset'.
clear gen_out.
'gen leaf format expression slots verified' of "" and false.
Print 'gen text'.

Print "--- the same leaf, another seed ---".
'rng seed' of 92.
'gen buffer names reset'.
clear gen_out.
'gen leaf format expression slots verified' of "" and false.

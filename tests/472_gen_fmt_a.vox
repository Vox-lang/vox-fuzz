Print "--- FMT-58: quoted one-word names in slots ---".
'rng seed' of 101.
'gen buffer names reset'.
clear gen_out.
'gen leaf format quoted names' of "" and false.
Print 'gen text'.

Print "--- the same leaf, another seed ---".
'rng seed' of 102.
'gen buffer names reset'.
clear gen_out.
'gen leaf format quoted names' of "" and false.
Print 'gen text'.

Print "--- FMT-40, 41, 42, 44: declarations in every branch ---".
'rng seed' of 111.
'gen buffer names reset'.
clear gen_out.
'gen leaf branch declarations verified' of "" and false.
Print 'gen text'.

Print "--- the same leaf, another seed ---".
'rng seed' of 112.
'gen buffer names reset'.
clear gen_out.
'gen leaf branch declarations verified' of "" and false.
Print 'gen text'.

Print "--- the same leaf, another seed ---".
'rng seed' of 113.
'gen buffer names reset'.
clear gen_out.
'gen leaf branch declarations verified' of "" and false.
Print 'gen text'.

Print "--- the same leaf, another seed ---".
'rng seed' of 114.
'gen buffer names reset'.
clear gen_out.
'gen leaf branch declarations verified' of "" and false.
Print 'gen text'.

Print "--- with no file I/O committed, the path sink stands aside ---".
Set gen_does_file_io to false.
'rng seed' of 120.
'gen buffer names reset'.
clear gen_out.
'gen leaf format path sink' of "" and false.
Print "the path sink emits a scratch path: {'gen text contains' of \"the workspace\"}".
Set gen_does_file_io to true.

Print "--- registration reachable: kinds 430-440 all dispatch ---".
a number called 'the kind' is 430.
While 'the kind' is less than 441,
    clear gen_out,
    'gen buffer names reset',
    'gen dispatch leaf' of 'the kind' and "" and false,
    Print "kind {'the kind'} emits a statement: {gen_out's length is greater than 0}",
    Set 'the kind' to 'the kind' add 1.
